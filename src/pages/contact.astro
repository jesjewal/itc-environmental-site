---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const facilityTypes = [
  'Hospital Pharmacy',
  'Compounding Pharmacy',
  'Laboratory',
  'Pharmaceutical Production',
  'Biotech / Research',
  'Other',
];

const serviceTypes = [
  'BSC Certification',
  'Laminar Flow Hood Certification',
  'Isolator CAI/CACI Certification',
  'Cleanroom Certification',
  'Fume Hood Testing',
  'HEPA Filter Integrity Testing',
  'Microbiological Testing',
  'Certification Documentation',
  'Multiple / Not Sure',
];
---

<Layout title="Contact" description="Request a quote or get in touch with ITC Environmental. Personalized service, quick response.">
  <Nav />

  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Contact</p>
      <h1>Request a Quote</h1>
      <p class="page-sub">Whether you need a detailed quote or just want more information, we're committed to providing quick, personalized service every step of the way.</p>
    </div>
  </section>

  <section class="contact-section">
    <div class="container contact-grid">

      <div class="contact-form-wrap">
        <form class="contact-form" name="quote-request" method="POST" data-netlify="true">
          <input type="hidden" name="form-name" value="quote-request" />

          <div class="form-row">
            <div class="form-group">
              <label for="name">Name</label>
              <input type="text" id="name" name="name" required placeholder="Your name" />
            </div>
            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" required placeholder="your@email.com" />
            </div>
          </div>

          <div class="form-group">
            <label for="facility">Facility Type</label>
            <select id="facility" name="facility">
              <option value="" disabled selected>Select your facility type</option>
              {facilityTypes.map(f => <option value={f}>{f}</option>)}
            </select>
          </div>

          <div class="form-group">
            <label for="service">Service Needed</label>
            <select id="service" name="service">
              <option value="" disabled selected>Select a service</option>
              {serviceTypes.map(s => <option value={s}>{s}</option>)}
            </select>
          </div>

          <div class="form-group">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="5" placeholder="Tell us about your facility and what you need. Include timeline or urgency if relevant."></textarea>
          </div>

          <button type="submit" class="btn btn-primary btn-lg btn-full">Send Request</button>
        </form>
      </div>

      <div class="contact-info">
        <p>Reach ITC Environmental directly. No dispatchers, no call centers — expect a response within one business day.</p>

        <div class="contact-detail">
          <p class="contact-label">Phone</p>
          <a href="tel:+13179462683">(317) 946-2683</a>
        </div>

        <div class="contact-detail">
          <p class="contact-label">Email</p>
          <a href="mailto:zheiden@itc-environmental.com">zheiden@itc-environmental.com</a>
        </div>

        <div class="contact-detail">
          <p class="contact-label">Location</p>
          <p>Indianapolis, IN<br/>Serving facilities nationwide</p>
        </div>

        <div class="contact-detail">
          <p class="contact-label">Response Time</p>
          <p>Typically within one business day.</p>
        </div>

        <div class="contact-note">
          <p><strong>Need emergency response?</strong> Flag it in your message — ITC can mobilize for time-sensitive compliance needs.</p>
        </div>
      </div>

    </div>
  </section>

  <Footer />
</Layout>

<style>
  .page-hero {
    background:
      linear-gradient(135deg, rgba(31,53,96,0.82) 0%, rgba(31,53,96,0.65) 100%),
      url('/images/actionshots/cleanroom-pressure-door-test.jpg') center 40%/cover no-repeat;
    color: #fff;
    padding: 5rem 0 4rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .eyebrow {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--teal-light);
    margin-bottom: 0.75rem;
  }

  .page-hero h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .page-sub {
    color: rgba(255,255,255,0.75);
    font-size: 1.0625rem;
    max-width: 600px;
    line-height: 1.7;
  }

  .contact-section {
    padding: 5rem 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.75fr 1fr;
    gap: 5rem;
    align-items: start;
  }

  .contact-info h2 {
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 0.75rem;
  }

  .contact-info > p {
    color: var(--slate);
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .contact-detail {
    margin-bottom: 1.5rem;
  }

  .contact-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--teal);
    margin-bottom: 0.25rem;
  }

  .contact-detail a,
  .contact-detail p {
    font-size: 0.9375rem;
    color: var(--dark);
    line-height: 1.6;
  }

  .contact-detail a:hover {
    color: var(--teal);
  }

  .contact-note {
    background: var(--off-white);
    border-left: 3px solid var(--teal);
    padding: 1rem 1.25rem;
    border-radius: 0 4px 4px 0;
    margin-top: 2rem;
  }

  .contact-note p {
    font-size: 0.875rem;
    color: var(--slate);
    line-height: 1.6;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .form-group label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--dark);
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    font-family: var(--font);
    font-size: 0.9375rem;
    padding: 0.75rem 1rem;
    border: 1.5px solid var(--border);
    border-radius: 4px;
    color: var(--dark);
    background: #fff;
    transition: border-color 0.2s;
    appearance: none;
    -webkit-appearance: none;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--teal);
  }

  .form-group textarea {
    resize: vertical;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    border-radius: 4px;
    font-family: var(--font);
    font-weight: 600;
    font-size: 0.9375rem;
    transition: all 0.2s;
    border: 2px solid transparent;
    cursor: pointer;
  }

  .btn-primary {
    background: var(--teal);
    color: #fff;
  }

  .btn-primary:hover {
    background: var(--teal-light);
  }

  .btn-lg { padding: 1rem 2rem; font-size: 1rem; }
  .btn-full { width: 100%; }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  @media (max-width: 560px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>
