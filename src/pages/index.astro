---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const faqs = [
  {
    q: 'How often does a biological safety cabinet (BSC) need to be certified?',
    a: 'Biological safety cabinets must be certified annually under NSF/ANSI 49. Recertification is also required after relocation, service, or repair that affects the HEPA filter or airflow system.',
  },
  {
    q: 'What is USP 797 and USP 800 testing?',
    a: 'USP Chapter 797 establishes standards for sterile compounding environments, requiring certification of ISO Class 5 primary engineering controls (PECs) such as biological safety cabinets and isolators at minimum every six months. USP Chapter 800 adds requirements for hazardous drug handling, including containment primary engineering controls (C-PECs). ITC Environmental provides full USP 797/800 certification testing for hospital pharmacies and compounding pharmacies.',
  },
  {
    q: 'What is NSF/ANSI 49 certification for biological safety cabinets?',
    a: 'NSF/ANSI 49 is the American national standard governing the performance, construction, and field certification of Class II biosafety cabinets. A certified NSF/ANSI 49 field technician performs inflow and downflow velocity profiling, HEPA filter integrity testing using PAO aerosol challenge, and airflow smoke pattern visualization to verify the cabinet is protecting both the user and the product.',
  },
  {
    q: 'What is PAO aerosol challenge testing?',
    a: 'PAO (poly-alpha olefin) aerosol challenge testing is the method used to detect leaks in installed HEPA filters. A photometer scans the full filter face while a polydisperse aerosol is introduced upstream. Any penetration greater than 0.01% indicates a leak. This test is required under NSF/ANSI 49, IEST-RP-CC034, and ISO 14644-3 for biological safety cabinets, cleanrooms, and other critical environments.',
  },
  {
    q: 'How often do cleanrooms need to be certified?',
    a: 'ISO 14644-2 recommends particle count re-verification at least every 6 months for ISO Class 5 and cleaner, and every 12 months for ISO Class 6 through 9. USP 797 compounding pharmacies with ISO Class 5 and 7 environments require semi-annual testing. GMP-regulated pharmaceutical facilities follow site-specific validation schedules. ITC Environmental provides full ISO 14644-1 classification testing and GMP compliance documentation.',
  },
  {
    q: 'What types of facilities does ITC Environmental serve?',
    a: 'ITC Environmental serves hospital pharmacies, compounding pharmacies, pharmaceutical research and production facilities, university and commercial laboratories, and any facility operating biological safety cabinets, laminar flow hoods, isolators, cleanrooms, or fume hoods. ITC provides services nationwide and is based in Indianapolis, Indiana.',
  },
  {
    q: 'What is the difference between a CAI and a CACI?',
    a: 'A Compounding Aseptic Isolator (CAI) is used for non-hazardous sterile compounding and must meet USP 797 requirements for ISO Class 5 environments. A Compounding Aseptic Containment Isolator (CACI) is designed for hazardous drug compounding per USP 800, providing both aseptic conditions and containment to protect personnel. ITC Environmental certifies both CAI and CACI units.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(({ q, a }) => ({
    "@type": "Question",
    "name": q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": a,
    },
  })),
};

const services = [
  { id: 'bsc', label: 'BSC Certification', alt: 'Biological safety cabinet in a hospital pharmacy cleanroom', image: '/images/services/bsc-large.jpeg' },
  { id: 'laminar-flow', label: 'Laminar Flow Hoods', alt: 'Horizontal laminar flow hood in a laboratory setting', image: '/images/services/laminar-flow-large.jpeg' },
  { id: 'isolator', label: 'Isolator CAI/CACI', alt: 'Compounding aseptic isolator for sterile drug compounding', image: '/images/services/isolator-large.jpeg' },
  { id: 'cleanroom', label: 'Cleanroom Certification', alt: 'ISO-classified pharmaceutical cleanroom with HEPA ceiling filters', image: '/images/services/cleanroom-large.jpeg' },
  { id: 'fume-hood', label: 'Fume Hood Testing', alt: 'Laboratory chemical fume hood with open sash for face velocity testing', image: '/images/services/fume-hood-large.jpeg' },
  { id: 'hepa', label: 'HEPA Filter Integrity', alt: 'HEPA filter panel in a cleanroom ceiling array', image: '/images/services/hepa-large.jpeg' },
  { id: 'micro', label: 'Microbiological Testing', alt: 'Petri dishes with agar media for microbiological environmental sampling', image: '/images/services/petri-dish-large.jpeg' },
  { id: 'docs', label: 'Certification Documentation', alt: 'Compliance certification report on clipboard for pharmacy inspection', image: '/images/services/certification-docs-large.jpeg' },
];

const valueProps = [
  {
    heading: 'Personalized Focus',
    body: 'Every job is unique, and so is our approach. We take time to understand your needs and provide a customized quote that fits your workflow, budget, and timeline.',
    svg: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>`,
  },
  {
    heading: 'Flexible Scheduling',
    body: 'We work around your facility\'s schedule — not the other way around. Whether planned recertification or urgent compliance needs, we accommodate.',
    svg: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><circle cx="12" cy="16" r="2"/><path d="M12 14v-2"/></svg>`,
  },
  {
    heading: 'Emergency Response',
    body: 'Critical environments can\'t wait. ITC offers emergency response for time-sensitive certification and testing needs.',
    svg: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`,
  },
];
---

<Layout
  description="ITC Environmental provides USP 797/800 testing and certification, BSC certification, cleanroom certification, and HEPA filter integrity testing for hospital pharmacies, compounding pharmacies, and laboratories nationwide."
  pageSchema={faqSchema}
  preloadImage="/images/hero-poster.jpg"
>
  <Nav />

  <!-- Hero -->
  <section class="hero">
    <video autoplay muted loop playsinline poster="/images/hero-poster.jpg" class="hero-video">
      <source src="/images/hero-video.mp4" type="video/mp4" />
    </video>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <h1 class="hero-eyebrow">Environmental Testing &amp; Certification</h1>
      <p class="hero-tagline">Certified.<br />Accountable.<br />Done Right.</p>
      <p class="hero-sub">ITC Environmental provides USP 797/800 testing and certification for hospital pharmacies and compounding pharmacies — and across all critical controlled environments including labs, pharmaceutical production facilities, and more.</p>
      <div class="hero-actions">
        <a href="/contact" class="btn btn-primary">Request a Quote</a>
        <a href="/services" class="btn btn-ghost">See Services</a>
      </div>
      <p class="hero-reach">Serving facilities nationwide &nbsp;·&nbsp; Based in Indianapolis, IN</p>
    </div>
  </section>

  <!-- Stats Bar -->
  <div class="stats-bar">
    <div class="stats-inner">
      <div class="stat">
        <span class="stat-num">15+</span>
        <span class="stat-label">Years in the Field</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-num">8</span>
        <span class="stat-label">Certified Services</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-num">NSF/ANSI 49</span>
        <span class="stat-label">Certified Technician</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-num">Nationwide</span>
        <span class="stat-label">Service Coverage</span>
      </div>
    </div>
  </div>

  <!-- Services Grid -->
  <section class="section services-section">
    <div class="container">
      <div class="section-header">
        <h2>What We Certify</h2>
        <p>Rigorous testing across every critical environment your facility operates.</p>
      </div>
      <div class="services-grid">
        {services.map(s => (
          <a href={`/services#${s.id}`} class="service-card">
            <div class="service-card-img">
              <img src={s.image} alt={s.alt} loading="lazy" />
            </div>
            <div class="service-card-foot">
              <span class="service-label">{s.label}</span>
              <span class="service-arrow">→</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Why ITC -->
  <section class="section why-section">
    <div class="container">
      <div class="section-header">
        <h2>Why ITC Environmental</h2>
        <p>Independent. Accountable. Built around the needs of critical environments.</p>
      </div>
      <div class="value-props">
        {valueProps.map(vp => (
          <div class="value-card">
            <div class="value-icon-wrap" set:html={vp.svg} />
            <h3>{vp.heading}</h3>
            <p>{vp.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="section process-section">
    <div class="container">
      <div class="section-header">
        <h2>How It Works</h2>
        <p>Getting certified with ITC is straightforward. No account managers, no runaround.</p>
      </div>
      <div class="process-steps">
        <div class="process-step">
          <div class="step-num">01</div>
          <h3>Request a Quote</h3>
          <p>Tell us your facility type and what you need. You'll hear directly from Zach — typically within one business day.</p>
        </div>
        <div class="process-connector"></div>
        <div class="process-step">
          <div class="step-num">02</div>
          <h3>Schedule Testing</h3>
          <p>We work around your facility's schedule. Planned recertification or emergency response — we accommodate.</p>
        </div>
        <div class="process-connector"></div>
        <div class="process-step">
          <div class="step-num">03</div>
          <h3>On-Site Testing</h3>
          <p>Zach performs all testing personally using calibrated equipment to applicable standards — NSF/ANSI 49, ISO 14644, USP 797/800.</p>
        </div>
        <div class="process-connector"></div>
        <div class="process-step">
          <div class="step-num">04</div>
          <h3>Compliance Documentation</h3>
          <p>Receive audit-ready compliance reports formatted for regulators, accreditation bodies, and internal QA teams.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- About ITC -->
  <section class="zach-section">
    <div class="container zach-inner">
      <div class="zach-photo">
        <img src="/images/actionshots/bsc-smoke-visualization.jpg" alt="ITC Environmental technician performing BSC smoke visualization test" />
      </div>
      <div class="zach-copy">
        <blockquote>"No call centers. No account managers. Direct access to the people doing the work."</blockquote>
        <p>ITC Environmental was founded to serve laboratories, hospital pharmacies, compounding pharmacies, and pharmaceutical production facilities that expect rigorous standards and direct communication. Every facility gets the same level of attention — whether it's a single BSC in a hospital pharmacy or a multi-suite compounding operation.</p>
        <a href="/about" class="btn btn-outline">About ITC →</a>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="testimonials-section">
    <div class="container">
      <div class="section-header">
        <h2>What Clients Say</h2>
        <p>Facilities that rely on ITC for recurring certification and compliance.</p>
      </div>

      <div class="carousel" id="testimonial-carousel">
        <div class="carousel-track">
          <div class="testimonial-card active">
            <p class="testimonial-quote">Zach is thorough and easy to work with. We've used ITC for our annual BSC recertification for two years and the documentation has held up to every inspection without question.</p>
            <div class="testimonial-attr">
              <span class="testimonial-name">Director of Pharmacy</span>
              <span class="testimonial-org">Regional Hospital System — Indianapolis, IN</span>
            </div>
          </div>
          <div class="testimonial-card">
            <p class="testimonial-quote">We needed emergency cleanroom recertification after a maintenance issue and ITC turned it around fast. Clear communication, solid report, no surprises.</p>
            <div class="testimonial-attr">
              <span class="testimonial-name">Compliance Manager</span>
              <span class="testimonial-org">Compounding Pharmacy — Cincinnati, OH</span>
            </div>
          </div>
          <div class="testimonial-card">
            <p class="testimonial-quote">The certification documentation ITC provides is exactly what our QA team needs — formatted correctly, complete, and ready for the accreditation body without any back and forth.</p>
            <div class="testimonial-attr">
              <span class="testimonial-name">Quality Assurance Lead</span>
              <span class="testimonial-org">Pharmaceutical Research Facility — Chicago, IL</span>
            </div>
          </div>
        </div>

        <div class="carousel-controls">
          <button class="carousel-btn prev" aria-label="Previous testimonial">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <div class="carousel-dots">
            <button class="dot active" aria-label="Testimonial 1"></button>
            <button class="dot" aria-label="Testimonial 2"></button>
            <button class="dot" aria-label="Testimonial 3"></button>
          </div>
          <button class="carousel-btn next" aria-label="Next testimonial">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section faq-section">
    <div class="container">
      <div class="section-header">
        <h2>Common Questions</h2>
        <p>Answers about certification requirements, testing methods, and what to expect from ITC.</p>
      </div>
      <div class="faq-list">
        {faqs.map((faq, i) => (
          <details class="faq-item" name="faq">
            <summary class="faq-question">
              <span>{faq.q}</span>
              <svg class="faq-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div class="faq-answer">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Band -->
  <section class="cta-band">
    <div class="container">
      <h2>Ready to schedule your certification?</h2>
      <p>Quick, personalized service every step of the way.</p>
      <a href="/contact" class="btn btn-primary btn-lg">Get a Quote</a>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* Stats Bar */
  .stats-bar {
    background: var(--navy);
    border-top: 1px solid rgba(255,255,255,0.08);
  }

  .stats-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1.75rem 3rem;
    text-align: center;
  }

  .stat-num {
    font-size: 1.5rem;
    font-weight: 700;
    color: #fff;
    line-height: 1;
    margin-bottom: 0.375rem;
  }

  .stat-label {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.55);
  }

  .stat-divider {
    width: 1px;
    height: 36px;
    background: rgba(255,255,255,0.15);
    flex-shrink: 0;
  }

  /* Process Section */
  .process-section {
    background: var(--off-white);
  }

  .process-steps {
    display: flex;
    align-items: flex-start;
    gap: 0;
  }

  .process-step {
    flex: 1;
    padding: 0 1.5rem;
  }

  .step-num {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--teal);
    opacity: 0.3;
    line-height: 1;
    margin-bottom: 1rem;
    font-variant-numeric: tabular-nums;
  }

  .process-step h3 {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--navy);
    margin-bottom: 0.625rem;
  }

  .process-step p {
    font-size: 0.9375rem;
    color: var(--slate);
    line-height: 1.7;
  }

  .process-connector {
    width: 48px;
    height: 2px;
    background: var(--border);
    flex-shrink: 0;
    margin-top: 1.25rem;
  }

  @media (max-width: 900px) {
    .stats-inner { flex-wrap: wrap; }
    .stat-divider { display: none; }
    .stat { padding: 1.25rem 1.5rem; }
    .process-steps { flex-direction: column; gap: 2rem; }
    .process-connector { display: none; }
    .process-step { padding: 0; }
  }

  .hero {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    color: #fff;
    background: url('/images/hero-poster.jpg') center/cover no-repeat;
  }

  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(31,53,96,0.88) 0%, rgba(0,123,138,0.55) 100%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    padding: 6rem 2rem;
    max-width: 680px;
    margin-left: 8vw;
  }

  .hero-eyebrow {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.7);
    margin-bottom: 1rem;
  }

  .hero-tagline {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    color: #fff;
  }

  .hero-sub {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: rgba(255,255,255,0.85);
    max-width: 520px;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .hero-reach {
    font-size: 0.8125rem;
    color: rgba(255,255,255,0.55);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    border-radius: 4px;
    font-weight: 600;
    font-size: 0.9375rem;
    transition: all 0.2s;
    cursor: pointer;
    border: 2px solid transparent;
  }

  .btn-primary {
    background: var(--teal);
    color: #fff;
  }

  .btn-primary:hover {
    background: var(--teal-light);
  }

  .btn-ghost {
    background: rgba(255,255,255,0.12);
    color: #fff;
    border-color: rgba(255,255,255,0.4);
  }

  .btn-ghost:hover {
    background: rgba(255,255,255,0.2);
  }

  .btn-outline {
    border-color: var(--navy);
    color: var(--navy);
  }

  .btn-outline:hover {
    background: var(--navy);
    color: #fff;
  }

  .btn-lg {
    padding: 1rem 2rem;
    font-size: 1rem;
  }

  .section {
    padding: 4rem 0 5rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-header h2 {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 0.75rem;
  }

  .section-header p {
    font-size: 1.0625rem;
    color: var(--slate);
    max-width: 520px;
    margin: 0 auto;
  }

  .services-section {
    background: var(--off-white);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .service-card {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s, box-shadow 0.2s;
    text-decoration: none;
  }

  .service-card:hover {
    border-color: var(--teal);
    box-shadow: 0 4px 16px rgba(0,123,138,0.12);
  }

  .service-card-img {
    aspect-ratio: 4/3;
    overflow: hidden;
    background: var(--off-white);
  }

  .service-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .service-card:hover .service-card-img img {
    transform: scale(1.04);
  }

  .service-card-foot {
    padding: 0.875rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .service-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--navy);
    line-height: 1.3;
  }

  .service-arrow {
    color: var(--teal);
    font-size: 1rem;
    flex-shrink: 0;
  }

  .value-props {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .value-card {
    background: #fff;
    border-radius: 10px;
    padding: 2rem;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .value-icon-wrap {
    width: 52px;
    height: 52px;
    background: rgba(0,123,138,0.1);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--teal);
    margin-bottom: 1.25rem;
    flex-shrink: 0;
  }

  .value-icon-wrap svg {
    width: 26px;
    height: 26px;
  }

  .value-card h3 {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 0.625rem;
  }

  .value-card p {
    font-size: 0.9375rem;
    color: var(--slate);
    line-height: 1.7;
  }

  .zach-section {
    background: #fff;
    padding: 5rem 0;
  }

  .zach-inner {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 4rem;
    align-items: center;
  }

  .zach-photo {
    width: 100%;
    border-radius: 8px;
    overflow: hidden;
  }

  .zach-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 8px;
  }

  .zach-copy blockquote {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 700;
    color: var(--navy);
    line-height: 1.3;
    margin-bottom: 1.25rem;
  }

  .zach-copy p {
    color: var(--slate);
    line-height: 1.7;
    margin-bottom: 1.5rem;
    max-width: 560px;
  }

  .testimonials-section {
    background: var(--navy);
    padding: 4rem 0 2.5rem;
  }

  .testimonials-section .section-header h2 {
    color: #fff;
  }

